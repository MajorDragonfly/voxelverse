+def _walking_start(capture):
+    # initial_address precedes settle; replaying its still-falling save may
+    # move it again before measurement. Compare the actual walk start.
+    outcomes = [row for row in capture.get("segments", [])
+                if row.get("stage") == "route_outcome" and row.get("cycle") == 0]
+    if len(outcomes) != 1 or len(outcomes[0].get("breadcrumbs", [])) < 2:
+        raise ValueError("Route comparison requires the actual first-cycle walking start")
+    return outcomes[0]["breadcrumbs"][0]
