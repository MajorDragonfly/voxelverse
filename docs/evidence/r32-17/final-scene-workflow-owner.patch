--- /dev/null
+++ b/.github/workflows/r32-17-final-scene.yml
@@ -0,0 +1,102 @@
+name: R32-17 combined scene comparison
+on:
+  push:
+    branches: [agent/r32-17-final-scene-20261002]
+  workflow_dispatch:
+permissions:
+  contents: read
+  actions: read
+concurrency:
+  group: r32-17-final-scene-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  capture:
+    runs-on: ubuntu-latest
+    timeout-minutes: 35
+    strategy:
+      fail-fast: false
+      matrix:
+        renderer: [gl_compatibility]
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: f2b0669a60db33ddecfe6704294add5f0219e910
+          fetch-depth: 0
+      - uses: ./.github/actions/setup-godot-editor
+        id: engine
+      - uses: actions/download-artifact@v4
+        with:
+          name: r32-17-combined-motion-gl_compatibility
+          run-id: 36974907744
+          github-token: ${{ secrets.GITHUB_TOKEN }}
+          path: /tmp/r32-17-original
+      - name: Import exact sources and preserve common saved scene
+        env:
+          GODOT: ${{ steps.engine.outputs.godot }}
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends xvfb xauth libgl1-mesa-dri mesa-vulkan-drivers ffmpeg
+          mkdir -p /tmp/r32-17-final
+          rm -f "$(dirname "$GODOT")/_sc_"
+          git worktree add --detach /tmp/r32-17-final-before 2a738a4891a8de11d682c469833ade4dc9b01dfb
+          cp tools/review_r32_17_*.gd tools/review_r32_17_*.gd.uid tools/review_r32_17_motion.py /tmp/r32-17-final-before/tools/
+          cp tests/r32_17_view_focus_test.gd tests/r32_17_checkpoint_test.gd /tmp/r32-17-final-before/tests/
+          "$GODOT" --headless --editor --path . --import > /tmp/r32-17-final/import.log 2>&1
+          set +e
+          "$GODOT" --headless --path . --script res://tests/r32_17_view_focus_test.gd > /tmp/r32-17-final/view-focus-base-negative.log 2>&1
+          code=$?
+          set -e
+          test "$code" = 1
+          python3 - <<'PY2'
+          import json
+          from pathlib import Path
+          rows=[json.loads(x) for x in Path('/tmp/r32-17-final/view-focus-base-negative.log').read_text().splitlines() if x.startswith('{')]
+          assert len(rows)==1 and rows[0]['current_camera_keeps_visual_and_physical_focus'] and not rows[0]['inactive_camera_keeps_physical_without_overwriting_observer'], rows
+          PY2
+          patch -p1 < docs/evidence/r32-17/view-focus-owner.patch
+          patch -d /tmp/r32-17-final-before -p1 < docs/evidence/r32-17/view-focus-owner.patch
+          "$GODOT" --headless --path . --script res://tests/r32_17_view_focus_test.gd > /tmp/r32-17-final/view-focus-owner-positive.log 2>&1
+          "$GODOT" --headless --path . --script res://tests/r32_17_checkpoint_test.gd > /tmp/r32-17-final/checkpoint-test.log 2>&1
+          cp tests/r32_17_view_focus_test.gd.uid tests/r32_17_checkpoint_test.gd.uid /tmp/r32-17-final/
+          cp -a .godot /tmp/r32-17-final-before/
+      - name: Compare actual work water weather pause distance and reload
+        env:
+          GODOT: ${{ steps.engine.outputs.godot }}
+          LIBGL_ALWAYS_SOFTWARE: '1'
+          LP_NUM_THREADS: '2'
+          renderer: ${{ matrix.renderer }}
+        run: |
+          export VK_ICD_FILENAMES="$(python3 -c 'from pathlib import Path; p=sorted(Path("/usr/share/vulkan/icd.d").glob("lvp_icd*.json")); assert len(p)==1; print(p[0])')"
+          set +e
+          xvfb-run -a -s '-screen 0 640x360x24' python3 tools/review_r32_17_motion.py --godot "$GODOT" --project /tmp/r32-17-final-before --mode capture --fixture /tmp/r32-17-original/prepare --renderer "$renderer" --timeout 900 --output /tmp/r32-17-final/before
+          before_code=$?
+          xvfb-run -a -s '-screen 0 640x360x24' python3 tools/review_r32_17_motion.py --godot "$GODOT" --mode capture --fixture /tmp/r32-17-original/prepare --renderer "$renderer" --timeout 900 --output /tmp/r32-17-final/after
+          after_code=$?
+          set -e
+          if test -f /tmp/r32-17-final/before/film.mp4 && test -f /tmp/r32-17-final/after/film.mp4; then
+            ffmpeg -v error -y -i /tmp/r32-17-final/before/film.mp4 -i /tmp/r32-17-final/after/film.mp4 -filter_complex hstack=inputs=2 -c:v libx264 -threads 2 -crf 23 -pix_fmt yuv420p -movflags +faststart /tmp/r32-17-final/comparison.mp4
+          fi
+          python3 - "$before_code" "$after_code" <<'PY'
+          import json,sys
+          from pathlib import Path
+          reports={k:json.loads((Path('/tmp/r32-17-final')/k/'capture.json').read_text()) for k in ['before','after']}
+          results={k:json.loads((Path('/tmp/r32-17-final')/k/'results.json').read_text()) for k in ['before','after']}
+          for k,c in reports.items():
+              assert len(c['frames'])==510 and c['frames'][-1]['stage']=='after_load', (k,len(c['frames']))
+              assert results[k]['exit_code'] in [0,1], (k,results[k]['exit_code'])
+          bad=[v['label'] for v in reports['before']['checks'] if not v['passed']]
+          assert bad==['tempo pause freezes tool pose/lifetime'], bad
+          assert int(sys.argv[1])==1 and int(sys.argv[2])==0 and results['after']['passed']
+          assert reports['after']['passed'], reports['after']
+          assert (Path('/tmp/r32-17-final')/'comparison.mp4').is_file()
+          PY
+      - name: Preserve original films traces and negative attempts
+        if: always()
+        run: |
+          find /tmp/r32-17-final -name 'frame_*.png' -delete
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: r32-17-final-${{ matrix.renderer }}
+          path: /tmp/r32-17-final
+          retention-days: 14
