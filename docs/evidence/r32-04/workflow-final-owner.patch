diff --git a/.github/workflows/r32-04-camera-evidence.yml b/.github/workflows/r32-04-camera-evidence.yml
new file mode 100644
index 0000000..a0f8120
--- /dev/null
+++ b/.github/workflows/r32-04-camera-evidence.yml
@@ -0,0 +1,50 @@
+name: R32-04 camera evidence
+on:
+  push:
+    branches: [agent/r32-04-camera-evidence-20261002]
+    paths: ['.github/workflows/r32-04-camera-evidence.yml', 'tools/review_r32_04*', 'world/tribe/tribe_camera.gd', 'tests/tribal_camera*']
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: r32-04-evidence-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  camera:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    strategy:
+      fail-fast: false
+      matrix:
+        renderer: [gl_compatibility]
+    env:
+      LIBGL_ALWAYS_SOFTWARE: "1"
+      LP_NUM_THREADS: "2"
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: ./.github/actions/setup-godot-editor
+        id: engine
+      - name: Prepare independent software display
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends xvfb xauth libgl1-mesa-dri mesa-vulkan-drivers
+      - name: Final focused contracts, exact reference-slot views and real shore
+        run: |
+          xvfb-run -a -s '-screen 0 1920x1080x24' python3 tools/review_r32_04.py \
+            --godot "${{ steps.engine.outputs.godot }}" --renderer "${{ matrix.renderer }}" \
+            --output "${{ runner.temp }}/r32-04-${{ matrix.renderer }}"
+          xvfb-run -a -s '-screen 0 1920x1080x24' python3 tools/review_r32_04_shore.py \
+            --godot "${{ steps.engine.outputs.godot }}" --skip-import \
+            --output "${{ runner.temp }}/r32-04-${{ matrix.renderer }}/shore"
+      - name: Preserve original evidence including negative runs
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: r32-04-camera-${{ matrix.renderer }}
+          path: |
+            ${{ runner.temp }}/r32-04-${{ matrix.renderer }}
+            !${{ runner.temp }}/r32-04-${{ matrix.renderer }}/**/*userdata/**
+          retention-days: 14
