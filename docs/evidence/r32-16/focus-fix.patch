diff --git a/audio/ui/audio_settings.gd b/audio/ui/audio_settings.gd
index 58a4942..c203726 100644
--- a/audio/ui/audio_settings.gd
+++ b/audio/ui/audio_settings.gd
@@ -72,6 +72,9 @@ func _ready() -> void:
 	_add_button(buttons, "AUDIO_BACK", func(): _audio.close_settings(), "CloseAudio")
 	_audio.settings_changed.connect(_sync)
 	_audio.settings_preview_changed.connect(_preview_changed)
+	# Background mute changes the mixer on focus events, without a fader edit.
+	get_window().focus_entered.connect(_update_status)
+	get_window().focus_exited.connect(_update_status)
 	get_node("/root/LocaleManager").language_changed.connect(func(_locale: String): _update_status())
 	get_viewport().size_changed.connect(_resize)
 	_resize()
diff --git a/tests/audio/audio_settings_test.gd b/tests/audio/audio_settings_test.gd
index 8372046..ab12283 100644
--- a/tests/audio/audio_settings_test.gd
+++ b/tests/audio/audio_settings_test.gd
@@ -60,6 +60,19 @@ func _run() -> void:
 		_expect(audio._preview_remaining > 0.0 and audio._settings_preview.stream != null, "No real preview stream: " + String(channel))
 		_expect(audio.music.current_context == context and audio.music._override == override, "Preview changed soundtrack ownership")
 	_expect(not audio.play_settings_preview(&"unknown"), "Unknown preview channel accepted")
+	# Background mute changes the actual master bus without changing a fader.
+	# The visible preview status must follow that same window-focus event.
+	root.focus_entered.emit()
+	audio.set_preference(&"mute_in_background", true)
+	audio.play_settings_preview(&"music")
+	root.focus_exited.emit()
+	_expect(AudioServer.is_bus_mute(AudioServer.get_bus_index(audio.CHANNELS[&"master"])), "Background focus did not mute Master")
+	var text = preload("res://core/localization/ui_text.gd")
+	_expect(panel._status.text == text.format_text("AUDIO_TEST_MUTED", {"channel": text.text("AUDIO_MUSIC")}), "Background-mute preview status still claims playback is audible")
+	root.focus_entered.emit()
+	_expect(not AudioServer.is_bus_mute(AudioServer.get_bus_index(audio.CHANNELS[&"master"])), "Foreground focus did not restore Master")
+	_expect(panel._status.text == text.format_text("AUDIO_TEST_PLAYING", {"channel": text.text("AUDIO_MUSIC")}), "Foreground preview status did not recover")
+	audio.set_preference(&"mute_in_background", false)
 	audio.play_settings_preview(&"music")
 	var preview_voice: int = audio._settings_preview.get_instance_id()
 	for i in 12: audio.play_settings_preview(&"music")
